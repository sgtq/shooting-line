VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# GitHub Pages repository Actions variables (the workflow maps these to VITE_*
# during builds; they are not used by local app builds).
PAGES_PRD_SUPABASE_URL=
PAGES_PRD_SUPABASE_PUBLISHABLE_KEY=
PAGES_PRD_SUPABASE_ACCESS_TOKEN=
PAGES_PRD_SUPABASE_DB_URL=
PAGES_PRD_SUPABASE_PROJECT_ID=

PAGES_DEV_SUPABASE_URL=
PAGES_DEV_SUPABASE_PUBLISHABLE_KEY=
PAGES_DEV_SUPABASE_ACCESS_TOKEN=
PAGES_DEV_SUPABASE_DB_URL=
PAGES_DEV_SUPABASE_PROJECT_ID=

PAGES_PRD_BASE_PATH=
PAGES_DEV_BASE_PATH=

# Cloudflare Pages deploy. Store these as GitHub Environment secrets in `production` and `development`.
# The token is limited to Cloudflare Pages edit. Never put real values in this file.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Store these as GitHub Environment variables (not secrets).
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_DISPLAY_NAME=

# Dev test users seed (npm run seed:dev). Development project only. It reads PAGES_DEV_SUPABASE_URL, and runs only
# when that URL belongs to SUPABASE_PROJECT_ID. It refuses a URL or id that matches PAGES_PRD_SUPABASE_URL. The
# service-role key never goes in a browser build. The password needs 12+ characters with upper, lower, digit, and
# a symbol.
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
SEED_USER_PASSWORD=
